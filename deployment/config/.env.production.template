# KDx Portal - Production Environment Variables
# Copy this file to /var/www/kdx-portal/.env and fill in your actual values

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000
VITE_APP_TITLE=WorldPath Regulatory Solutions
VITE_APP_ID=kdx-portal-prod

# ============================================
# DATABASE CONFIGURATION
# ============================================
# DigitalOcean Managed MySQL Database
# Get connection details from: Cloud > Databases > Your Database > Connection Details
DATABASE_URL=mysql://username:password@host:port/database?ssl-mode=REQUIRED

# Example:
# DATABASE_URL=mysql://doadmin:your_password@db-mysql-nyc3-12345-do-user-67890-0.b.db.ondigitalocean.com:25060/defaultdb?ssl-mode=REQUIRED

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate a secure random string for JWT_SECRET
# You can use: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_32_CHARS_OR_MORE

# OAuth Configuration (if using external OAuth)
OAUTH_SERVER_URL=https://your-oauth-server.com
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.com

# Owner Information
OWNER_OPEN_ID=your_owner_openid
OWNER_NAME=Bryan Schneider

# ============================================
# FILE STORAGE (DigitalOcean Spaces / S3)
# ============================================
# Create a Space at: Cloud > Spaces > Create
# Generate API keys at: API > Spaces Keys

# Spaces Configuration
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=kdx-portal-files
S3_ACCESS_KEY_ID=YOUR_SPACES_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SPACES_SECRET_KEY
S3_PUBLIC_URL=https://kdx-portal-files.nyc3.digitaloceanspaces.com

# Alternative: Use CDN URL for better performance
# S3_PUBLIC_URL=https://kdx-portal-files.nyc3.cdn.digitaloceanspaces.com

# ============================================
# BUILT-IN FORGE API (Manus Platform)
# ============================================
# If migrating from Manus, you'll need to replace these with your own services
# BUILT_IN_FORGE_API_URL=https://api.your-service.com
# BUILT_IN_FORGE_API_KEY=your_api_key
# VITE_FRONTEND_FORGE_API_KEY=your_frontend_api_key
# VITE_FRONTEND_FORGE_API_URL=https://api.your-service.com

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# For sending notifications, password resets, etc.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM=noreply@worldpathregulatory.world

# ============================================
# ANALYTICS (Optional)
# ============================================
# VITE_ANALYTICS_WEBSITE_ID=your_analytics_id
# VITE_ANALYTICS_ENDPOINT=https://analytics.your-service.com

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
LOG_FILE=/var/log/kdx-portal/application.log

# ============================================
# PERFORMANCE & LIMITS
# ============================================
# Maximum file upload size (in bytes)
MAX_FILE_SIZE=104857600  # 100MB

# Request rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=kdx-portal-backups
